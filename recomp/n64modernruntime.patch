+bool recomp::overlays::find_loaded_function(uint32_t vram, uint32_t& func_vram, uint32_t& func_rom, uint32_t& func_size) {
+    for (const LoadedSection& loaded : loaded_sections) {
+        const SectionTableEntry& section = sections_info.code_sections[loaded.section_table_index];
+        const uint32_t base = (uint32_t)loaded.loaded_ram_addr;
+        const uint32_t offset = vram - base;
+        if (offset >= section.size) {
+            continue;
+        }
+        for (size_t i = 0; i < section.num_funcs; i++) {
+            const FuncEntry& func = section.funcs[i];
+            if (offset >= func.offset && offset < func.offset + func.rom_size) {
+                func_vram = base + func.offset;
+                func_rom = section.rom_addr + func.offset;
+                func_size = func.rom_size;
+                return true;
+            }
+        }
+    }
+    return false;
+}
