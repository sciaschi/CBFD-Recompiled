+#include <chrono>
+#include <cstdio>
+#include <random>
+#include <thread>
+
+#include "ultramodern/ultramodern.hpp"
+#include "ultramodern/save_states.hpp"
+#include "ultramodern/timeline.hpp"
+
+// Deterministic mode (timeline.hpp). The timeline's own state is only used at delivery points, which
+// are on the game thread running at the time (one at a time), so it needs no lock.
+
+void dequeue_external_messages(RDRAM_ARG1);
+extern std::atomic_bool exited;
+std::chrono::microseconds ticks_to_duration(uint64_t ticks);
+
+namespace {
+    // Exactly 60 VIs a second: a whole number of ticks (46,875,000 a second) each.
+    constexpr uint64_t ticks_per_vi = 46'875'000 / 60;
+
+    std::atomic_bool deterministic = false;
+    bool fast = false;
+    std::atomic_bool catching_up = false;
+    // Set as catching up stops, for pace: from then it paces from where the game is, not from where it was
+    // before (the time it gained would be slept away, and the others ahead again).
+    std::atomic_bool pace_from_now = false;
+    // The time of the last delivery, and the next VI's number (VI k is at k × ticks_per_vi).
+    uint64_t now = 0;
+    uint64_t next_vi = 1;
+    // Real time at virtual time 0 (moved on after a stall, so the game doesn't then race to catch up).
+    std::chrono::high_resolution_clock::time_point real_start;
+
+    std::atomic<uint32_t> jitter_max_us = 0;
+
+    // The game's bursts of work between two delivery points: the OS calls in each, and the real time it
+    // took. The longest are logged: a game that never went idle (which no limit stops) would show here.
+    // Counted at OS calls, which in deterministic mode only game threads make (no host thread posts to the
+    // game), but atomic all the same.
+    std::atomic<uint64_t> burst_calls = 0;
+    std::chrono::high_resolution_clock::time_point burst_start;
+    bool in_burst = false;
+    uint64_t most_calls = 0;
+    std::chrono::microseconds longest{ 0 };
+
+    void burst_ended() {
+        if (!in_burst) {
+            return;
+        }
+        in_burst = false;
+        const auto took = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::high_resolution_clock::now() - burst_start);
+        bool more = false;
+        const uint64_t calls = burst_calls.load(std::memory_order_relaxed);
+        if (calls > most_calls) {
+            most_calls = calls;
+            more = true;
+        }
+        if (took > longest) {
+            longest = took;
+            more = true;
+        }
+        if (more) {
+            std::printf("[timeline] at %.2f s: a burst of %llu OS calls, %.2f ms (the most so far: %llu calls, %.2f ms)\n",
+                now / 46'875'000.0, (unsigned long long)calls, took.count() / 1000.0,
+                (unsigned long long)most_calls, longest.count() / 1000.0);
+            std::fflush(stdout);
+        }
+    }
+
+    void burst_started() {
+        in_burst = true;
+        burst_calls = 0;
+        burst_start = std::chrono::high_resolution_clock::now();
+    }
+
+    // Waits for real time to reach virtual time `ticks`.
+    void pace(uint64_t ticks) {
+        using namespace std::chrono_literals;
+        if (fast || catching_up.load(std::memory_order_relaxed)) {
+            return;
+        }
+        const auto real_now = std::chrono::high_resolution_clock::now();
+        if (pace_from_now.exchange(false)) {
+            real_start = real_now - ticks_to_duration(ticks);
+        }
+        const auto target = real_start + ticks_to_duration(ticks);
+        if (real_now < target) {
+            ultramodern::sleep_until(target);
+        }
+        else if (real_now - target > 100ms) {
+            real_start += real_now - target;
+        }
+    }
+}
+
+void ultramodern::timeline::enable(bool fast_) {
+    fast = fast_;
+    now = 0;
+    next_vi = 1;
+    deterministic = true;
+    ultramodern::timeline_parts::clock_enable();
+    ultramodern::timeline_parts::vi_take_over();
+    real_start = std::chrono::high_resolution_clock::now();
+}
+
+void ultramodern::timeline::set_catching_up(bool on) {
+    // Paced again from where the game is (from any thread: pace, on the game's, moves real_start).
+    if (!on && catching_up.exchange(false)) {
+        pace_from_now = true;
+    }
+    catching_up = on;
+}
+
+bool ultramodern::timeline::enabled() {
+    return deterministic.load();
+}
+
+uint64_t ultramodern::timeline::delivery_time() {
+    return now;
+}
+
+ultramodern::save_states::TimelineState ultramodern::save_states::get_timeline_state() {
+    if (!deterministic) {
+        return {};
+    }
+    return { 1, 0, now, next_vi, ultramodern::timeline_parts::dp_due(), 0 };
+}
+
+void ultramodern::save_states::set_timeline_state(const TimelineState* state, uint64_t clock) {
+    if (!deterministic) {
+        return;
+    }
+    if (state != nullptr && state->deterministic != 0) {
+        now = state->now;
+        next_vi = state->next_vi;
+        ultramodern::timeline_parts::set_dp_due(state->dp_due);
+    }
+    else {
+        // A state from normal mode: the timeline goes on from its clock, at the next whole VI.
+        now = clock;
+        next_vi = clock / ticks_per_vi + 1;
+        ultramodern::timeline_parts::set_dp_due(0);
+    }
+    // Paced from here, neither waiting for nor racing to the state's time.
+    real_start = std::chrono::high_resolution_clock::now() - ticks_to_duration(now);
+    in_burst = false;
+}
+
+void ultramodern::timeline::set_jitter(uint32_t max_us) {
+    jitter_max_us = max_us;
+}
+
+void ultramodern::timeline::os_call() {
+    if (!deterministic) {
+        return;
+    }
+    burst_calls.fetch_add(1, std::memory_order_relaxed);
+    jitter();
+}
+
+void ultramodern::timeline::jitter() {
+    const uint32_t max_us = jitter_max_us.load();
+    if (max_us == 0) {
+        return;
+    }
+    thread_local std::mt19937 random{ std::random_device{}() };
+    std::this_thread::sleep_for(std::chrono::microseconds{ random() % max_us });
+}
+
+void ultramodern::timeline::deliver(RDRAM_ARG bool until_woken, uint64_t max_ticks) {
+    burst_ended();
+    // The game's own messages first (PI, SI, SP done: posted by game threads, so in the same order
+    // every run).
+    dequeue_external_messages(PASS_RDRAM1);
+    if (until_woken && !thread_queue_empty(PASS_RDRAM running_queue)) {
+        burst_started();
+        return;
+    }
+    const uint64_t stop_at = until_woken ? UINT64_MAX : now + max_ticks;
+    while (true) {
+        // Once the game is quitting, its memory goes: the game waits for good, as it does in normal
+        // mode when nothing more arrives.
+        while (exited) {
+            std::this_thread::sleep_for(std::chrono::seconds{ 1 });
+        }
+        // The next event: the next VI, or a timer that runs out sooner (never before the last).
+        const uint64_t vi_time = next_vi * ticks_per_vi;
+        uint64_t at = vi_time;
+        uint64_t deadline;
+        if (ultramodern::timeline_parts::timers_next_deadline(PASS_RDRAM deadline) && deadline < at) {
+            at = deadline;
+        }
+        at = std::max(at, now);
+        if (at > stop_at) {
+            pace(stop_at);
+            now = stop_at;
+            ultramodern::timeline_parts::clock_advance_to(now);
+            burst_started();
+            return;
+        }
+
+        pace(at);
+        now = at;
+        ultramodern::timeline_parts::clock_advance_to(now);
+        // In this order: DP done before the VI it's due at, so the scheduler sees the task done at the VI.
+        const bool vi_due = at == vi_time;
+        if (vi_due) {
+            ultramodern::timeline_parts::dp_deliver();
+        }
+        ultramodern::timeline_parts::timers_fire_due(PASS_RDRAM now);
+        if (vi_due) {
+            ultramodern::timeline_parts::vi_deliver(PASS_RDRAM1);
+            next_vi++;
+        }
+        dequeue_external_messages(PASS_RDRAM1);
+
+        if (until_woken && !thread_queue_empty(PASS_RDRAM running_queue)) {
+            burst_started();
+            return;
+        }
+    }
+}
