-        PAGE_READWRITE,
+        PAGE_EXECUTE_READWRITE,
         &old_flags_dword);
     *old_flags = old_flags_dword;
     (void)result;
@@ -233,7 +235,13 @@ void unprotect(void* target_func, uint64_t* old_flags) {
     int page_size = getpagesize();
     page_start = (page_start / page_size) * page_size;
 
+#if defined(__APPLE__)
+    // Apple Silicon doesn't allow pages both writable and executable.
     int result = mprotect((void*)page_start, page_size, PROT_READ | PROT_WRITE);
+#else
+    // Keep the page executable while it's patched: other threads may be running code on it.
+    int result = mprotect((void*)page_start, page_size, PROT_READ | PROT_WRITE | PROT_EXEC);
+#endif
     *old_flags = 0;
     (void)result;
 }
