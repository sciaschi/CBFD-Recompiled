+#ifndef __ULTRAMODERN_TIMELINE_HPP__
+#define __ULTRAMODERN_TIMELINE_HPP__
+
+#include <cstdint>
+
+#include "ultra64.h"
+
+// Deterministic mode, for replays and netplay: the game runs on a virtual timeline instead of the
+// time, so the same inputs give the same game however fast the host is.
+//
+// Game code takes no virtual time. Events (VIs, timers, DP done) are delivered only at delivery
+// points, when the game is idle (every game thread waits): there virtual time moves straight to the
+// next event. No host thread posts to the game: the VI and timer threads stop, the audio task runs on
+// the game thread that starts it, and the graphics thread only reports that it's done. The game's
+// clock (osGetCount, osGetTime) is the timeline's time, plus a step each time the game reads it.
+namespace ultramodern {
+    namespace timeline {
+        // Turns deterministic mode on, for good: call it before the game starts. `fast` doesn't wait for
+        // real time to reach each event (headless replays).
+        void enable(bool fast);
+        bool enabled();
+        // While on, the timeline doesn't wait for real time either, as `fast`: a game that fell behind (netplay,
+        // behind the other players) catches up. Once off, it's paced again from where it is (any game thread).
+        void set_catching_up(bool on);
+        // The time of the last delivery (ticks): the time on the game's side between delivery points, as
+        // events have reached the game. Unlike the game's clock, reading it doesn't move it. On a game
+        // thread.
+        uint64_t delivery_time();
+        // Random sleeps of up to `max_us` microseconds at OS calls and in the graphics thread, to show
+        // anything that still depends on how fast the host is (a test; 0 is off).
+        void set_jitter(uint32_t max_us);
+        void jitter();
+        // At each OS call that hands over messages (send, jam, receive), on a game thread: counts them
+        // (and jitters).
+        void os_call();
+
+        // A delivery point, on a game thread: delivers the events due next, in order, until one wakes a
+        // thread (`until_woken`), or (not `until_woken`) for at most `max_ticks` of virtual time.
+        void deliver(RDRAM_ARG bool until_woken, uint64_t max_ticks);
+    }
+
+    // The timeline's pieces in the runtime's other files.
+    namespace timeline_parts {
+        // timer.cpp
+        void clock_enable();
+        void clock_advance_to(uint64_t ticks);
+        bool timers_next_deadline(RDRAM_ARG uint64_t& deadline);
+        void timers_fire_due(RDRAM_ARG uint64_t ticks);
+        // events.cpp
+        void vi_take_over();
+        void vi_deliver(RDRAM_ARG1);
+        void dp_deliver();
+        // Save states: the graphics tasks whose DP done is due, and setting it on a load (with no task
+        // in flight).
+        uint32_t dp_due();
+        void set_dp_due(uint32_t count);
+    }
+}
+
+#endif
