+    const bool controller = device == recompinput::InputDevice::Controller;
+    const int default_index = recompinput::profiles::get_default_sp_profile_index(device);
+    const int current_index = controller
+        ? recompinput::profiles::get_sp_port_controller_profile_index(selected_port)
+        : recompinput::profiles::get_sp_keyboard_profile_index();
+    // Players 2-4 can play with player 1's profile (-1), which their bar then shows but doesn't rename or delete.
+    const int current_choice = controller && selected_port > 0
+        ? recompinput::profiles::get_sp_port_controller_profile_choice(selected_port)
+        : current_index;
+    const bool current_custom = current_choice >= 0 && recompinput::profiles::is_input_profile_custom(current_index);
+
+    auto header_left = header->get_left();
+    header_left->clear_children();
+
+    // Each controller port's own profile (issue #160); the keyboard and mouse are player 1's.
+    if (controller) {
+        std::vector<SelectOption> player_options;
+        for (int port = 0; port < recompinput::profiles::sp_controller_port_count; port++) {
+            player_options.emplace_back("Player " + std::to_string(port + 1), std::to_string(port));
+        }
+        auto player_wrapper = context.create_element<Element>(header_left, 0, "div", false);
+        // Wide enough for the select's own minimum (ui_select.cpp), with a gap before the profile's label.
+        player_wrapper->set_width(192.0f);
+        player_wrapper->set_margin_right(16.0f);
+        auto player_select = context.create_element<Select>(player_wrapper, player_options, std::to_string(selected_port));
+        player_select->add_change_callback([this](SelectOption &option, int option_index) {
+            this->selected_port = std::stoi(option.value);
             this->update_control_mappings();
+            this->queue_profile_render = true;
+        });
+    }
+    context.create_element<Label>(header_left, "Profile", LabelStyle::Normal);
+
+    std::vector<SelectOption> profile_options;
+    if (controller && selected_port > 0) {
+        profile_options.emplace_back("Same as Player 1", "-1");
+    }
+    profile_options.emplace_back("Default", std::to_string(default_index));
+    for (int profile_index : recompinput::profiles::get_indices_for_custom_profiles(device)) {
+        profile_options.emplace_back(recompinput::profiles::get_input_profile_name(profile_index), std::to_string(profile_index));
+    }
+    auto profile_wrapper = context.create_element<Element>(header_left, 0, "div", false);
+    profile_wrapper->set_width(240.0f);
+    auto profile_select = context.create_element<Select>(profile_wrapper, profile_options, std::to_string(current_choice));
+    profile_select->add_change_callback([this](SelectOption &option, int option_index) {
+        this->on_select_sp_profile(std::stoi(option.value));
+    });
+
+    // A custom profile's name, renamed as it's typed (the list shows it once it's done).
+    if (current_custom) {
+        auto name_input = context.create_element<TextInput>(header_left);
+        name_input->set_width(240.0f);
+        name_input->set_text(recompinput::profiles::get_input_profile_name(current_index));
+        name_input->add_text_changed_callback([current_index](const std::string &text) {
+            recompinput::profiles::rename_input_profile(current_index, text);
+        });
+        name_input->set_focus_callback([this](bool active) {
+            if (!active) {
+                this->queue_profile_render = true;
+            }
+        });
+    }
+
+    auto header_right = header->get_right();
+    header_right->clear_children();
+    // Which controller is which player: each presses a button in turn (issue #160).
+    if (controller) {
+        auto assign_button = context.create_element<Button>(header_right, "Assign controllers", ButtonStyle::Primary, ButtonSize::Medium);
+        assign_button->set_debug_id("AssignControllersButton");
+        assign_button->add_pressed_callback([]() {
+            recompinput::playerassignment::start();
+            recompui::AssignPlayersModal::open();
         });
     }
+    auto new_button = context.create_element<Button>(header_right, "New profile", ButtonStyle::Secondary, ButtonSize::Medium);
+    new_button->add_pressed_callback([this]() {
+        this->on_new_profile();
+    });
+    auto delete_button = context.create_element<Button>(header_right, "Delete profile", ButtonStyle::Danger, ButtonSize::Medium);
+    delete_button->set_enabled(current_custom);
+    delete_button->add_pressed_callback([this]() {
+        this->on_delete_profile();
+    });
+}
+
+void ConfigPageControls::on_select_sp_profile(int profile_index) {
+    if (get_player_input_device() == recompinput::InputDevice::Controller) {
+        recompinput::profiles::set_sp_port_controller_profile_index(selected_port, profile_index);
+    } else {
+        recompinput::profiles::set_sp_profile_index(recompinput::InputDevice::Keyboard, profile_index);
+    }
+    update_control_mappings();
+    queue_profile_render = true;
+}
+
+void ConfigPageControls::on_new_profile() {
+    // A copy of the profile in use, named after the first number free.
+    const recompinput::InputDevice device = get_player_input_device();
+    const std::vector<int> custom_indices = recompinput::profiles::get_indices_for_custom_profiles(device);
+    std::string name;
+    for (int number = 1; name.empty(); number++) {
+        std::string candidate = "Profile " + std::to_string(number);
+        bool taken = false;
+        for (int profile_index : custom_indices) {
+            taken = taken || recompinput::profiles::get_input_profile_name(profile_index) == candidate;
+        }
+        if (!taken) {
+            name = candidate;
+        }
+    }
+    int profile_index = recompinput::profiles::create_custom_profile(device, name, selected_profile_index);
+    on_select_sp_profile(profile_index);
+}
+
+void ConfigPageControls::on_delete_profile() {
+    if (recompinput::profiles::is_input_profile_custom(selected_profile_index)) {
+        recompinput::profiles::delete_custom_profile(selected_profile_index);
+        update_control_mappings();
+        queue_profile_render = true;
+    }
 }
 
