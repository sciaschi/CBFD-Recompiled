+// The mouse wheel bound as an input (InputField::mouse_wheel_up, mouse_wheel_down): each notch holds it for
+// wheel_press, then lets go for wheel_gap before the next notch's press, so a bound button sees one press a notch
+// (notches scrolled faster wait their turn). Turned by the events (add_mouse_wheel_delta), read each poll.
+namespace {
+    constexpr std::chrono::milliseconds wheel_press{ 100 };
+    constexpr std::chrono::milliseconds wheel_gap{ 34 };
+    constexpr int max_pending_notches = 16;
+    struct WheelInput {
+        int pending = 0;
+        std::chrono::steady_clock::time_point press_end{};
+        std::chrono::steady_clock::time_point gap_end{};
+        bool held = false;
+    };
+    std::mutex wheel_mutex;
+    WheelInput wheel_inputs[2]; // up, down
+
+    void poll_wheel() {
+        const auto now = std::chrono::steady_clock::now();
+        std::lock_guard lock{ wheel_mutex };
+        for (WheelInput& wheel : wheel_inputs) {
+            if (wheel.held && now >= wheel.press_end) {
+                wheel.held = false;
+                wheel.gap_end = now + wheel_gap;
+            }
+            if (!wheel.held && wheel.pending > 0 && now >= wheel.gap_end) {
+                wheel.pending--;
+                wheel.held = true;
+                wheel.press_end = now + wheel_press;
+            }
+        }
+    }
+}
