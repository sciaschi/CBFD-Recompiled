+        const recompinput::InputDevice device = get_player_input_device();
+        std::vector<SelectOption> preset_options;
+        bool selected_found = false;
+        for (size_t i = 0; i < presets.size(); i++) {
+            if (presets[i].device == device) {
+                preset_options.emplace_back(presets[i].name, std::to_string(i));
+                selected_found = selected_found || (int)i == selected_preset_index;
+            }
+        }
+        if (!preset_options.empty()) {
+            if (!selected_found) {
+                selected_preset_index = std::stoi(preset_options[0].value);
+            }
+            auto preset_wrapper = context.create_element<Element>(footer_right, 0, "div", false);
+            preset_wrapper->set_width(240.0f);
