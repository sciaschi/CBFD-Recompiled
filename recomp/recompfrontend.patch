+    void start_game_file_installation(const std::filesystem::path &file_path, ModInstaller::Result &result) {
+        std::filesystem::path target_path = recomp::mods::get_mods_directory() / file_path.filename();
+        std::filesystem::path target_write_path = target_path.u8string() + NewExtension;
+        std::error_code ec;
+        std::filesystem::copy_file(file_path, target_write_path, std::filesystem::copy_options::overwrite_existing, ec);
+        if (ec) {
+            result.error_messages.emplace_back("Unable to install " + file_path.filename().string() + " to mod directory.");
