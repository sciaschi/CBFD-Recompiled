+void ConfigPageControls::render_player_toggles() {
+    if (player_toggles_wrapper == nullptr) {
+        return;
+    }
+    player_toggles_wrapper->clear_children();
+    if (get_player_input_device() != recompinput::InputDevice::Controller) {
+        return;
+    }
+    recompui::ContextId context = get_current_context();
+    const int player = selected_port;
+    for (const recompinput::PlayerToggle &player_toggle : recompinput::get_player_toggles()) {
+        context.create_element<Label>(player_toggles_wrapper, player_toggle.name, LabelStyle::Normal);
+        auto toggle = context.create_element<Toggle>(player_toggles_wrapper, ToggleSize::Medium);
+        toggle->set_checked(player_toggle.get ? player_toggle.get(player) : false);
+        auto set = player_toggle.set;
+        toggle->add_checked_callback([set, player](bool checked) {
+            if (set) {
+                set(player, checked);
+            }
+        });
+    }
+}
