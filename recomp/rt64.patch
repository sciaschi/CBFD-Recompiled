+// Conker: the pause menu's blurred background (RenderTarget::conkerBlur). One pass of three, by Mode:
+// 0 and 1 blur a picture across and down (a separable Gaussian, Radius texels each way), and 2 scales
+// the blurred picture back up to the target's size, bilinearly. Texels are read with Load, so no
+// sampler is involved and the picture's edges are clamped to.
+
+#define BLOCK_SIZE 8
+
+struct ConkerBlurCB {
+    uint2 InputResolution;
+    uint2 OutputResolution;
+    uint Mode;
+    uint Radius;
+    float Sigma;
+    uint Padding;
+};
+
+[[vk::push_constant]] ConstantBuffer<ConkerBlurCB> gConstants : register(b0);
+Texture2D<float4> gInput : register(t1);
+RWTexture2D<float4> gOutput : register(u2);
+
+float4 LoadClamped(int2 coord) {
+    int2 maxCoord = int2(gConstants.InputResolution) - int2(1, 1);
+    return gInput.Load(int3(clamp(coord, int2(0, 0), maxCoord), 0));
+}
+
+[numthreads(BLOCK_SIZE, BLOCK_SIZE, 1)]
+void CSMain(uint2 coord : SV_DispatchThreadID) {
+    if ((coord.x >= gConstants.OutputResolution.x) || (coord.y >= gConstants.OutputResolution.y)) {
+        return;
+    }
+
+    if (gConstants.Mode < 2) {
+        const int2 step = (gConstants.Mode == 0) ? int2(1, 0) : int2(0, 1);
+        const float twoSigmaSquared = 2.0f * gConstants.Sigma * gConstants.Sigma;
+        float4 sum = 0.0f;
+        float weightSum = 0.0f;
+        const int radius = int(gConstants.Radius);
+        for (int i = -radius; i <= radius; i++) {
+            const float weight = exp(-float(i * i) / twoSigmaSquared);
+            sum += LoadClamped(int2(coord) + step * i) * weight;
+            weightSum += weight;
+        }
+
+        gOutput[coord] = sum / weightSum;
+    }
+    else {
+        // The output texel's middle, in the input's texels.
+        const float2 scale = float2(gConstants.InputResolution) / float2(gConstants.OutputResolution);
+        const float2 position = (float2(coord) + 0.5f) * scale - 0.5f;
+        const int2 base = int2(floor(position));
+        const float2 t = position - float2(base);
+        const float4 top = lerp(LoadClamped(base), LoadClamped(base + int2(1, 0)), t.x);
+        const float4 bottom = lerp(LoadClamped(base + int2(0, 1)), LoadClamped(base + int2(1, 1)), t.x);
+        gOutput[coord] = lerp(top, bottom, t.y);
+    }
+}
