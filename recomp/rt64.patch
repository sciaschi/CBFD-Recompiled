diff --git a/src/common/rt64_conker_view_focus.h b/src/common/rt64_conker_view_focus.h
new file mode 100644
index 0000000..168a50c
--- /dev/null
+++ b/src/common/rt64_conker_view_focus.h
@@ -0,0 +1,195 @@
+//
+// RT64
+//
+
+// Conker: netplay's "my view only", drawn anew (the host's netplay/view.cpp). While it's on, this machine's players'
+// views of the split screen are each drawn across a part of the frame of their own instead of their part of the
+// split, and the other views aren't drawn: one player's view across the whole frame, two players' views across the
+// top and bottom halves. Each view's viewport and scissor are moved and stretched with it (RSP::setViewport,
+// RDP::setScissor; a smaller one inside the view goes to the same place in the stretched view), and its projection
+// is scaled by as much as the stretch isn't uniform (ProjectionProcessor), so nothing is stretched: a view made
+// relatively taller shows more of the scene up and down, one made relatively wider more of it across. The widescreen
+// widening then widens each like any view across the frame's width. The other views' viewports are collapsed to
+// nothing and their scissors emptied, which also leaves out their 2D. Rectangles in pixels of the frame, which is
+// frameWidth by frameHeight. Only the renderer changes: the game's memory doesn't (its Render to RAM is off in
+// netplay), so it can't desync.
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+#include "common/rt64_common.h"
+
+
+namespace RT64 {
+    // One focused view: where the game draws it (src), and where it's drawn instead.
+    struct ConkerFocusView {
+        float srcLeft = 0.0f, srcTop = 0.0f, srcRight = 0.0f, srcBottom = 0.0f;
+        float left = 0.0f, top = 0.0f, right = 0.0f, bottom = 0.0f;
+    };
+
+    constexpr int ConkerMaxFocusViews = 2;
+
+    struct ConkerViewFocus {
+        bool on = false;
+        int count = 0;
+        ConkerFocusView views[ConkerMaxFocusViews];
+        float frameWidth = 0.0f, frameHeight = 0.0f;
+        uint32_t ownImages[2] = {};
+    };
+
+    // Set by the game's host each frame (defined in rt64_vi_renderer.cpp): `count` views (1 or 2), each 8 floats in
+    // `rects`, its rectangle in the split then where it's drawn (left, top, right, bottom). ownImages: the
+    // addresses of two images as wide as the frame that aren't it (0 for none), the game's own copies of it (the
+    // pause menu's picture, which is also the depth image: its clear covers the whole frame, left alone anyway).
+    void setViewFocusRedraw(bool on, int count, const float *rects, float frameWidth, float frameHeight,
+        uint32_t ownImage0, uint32_t ownImage1);
+    ConkerViewFocus conkerViewFocus();
+
+    // Whether the focus applies to what's drawn now: only to the frame itself, an image as wide as the frame.
+    // The game also draws into small images of its own (a shadow's silhouette, 64 pixels wide), which the
+    // frame's views have nothing to do with, and into copies of the frame as wide as it (the pause menu's
+    // picture: tiles of the frame across all of it, which moved with the views, or left out, left the picture
+    // as it was in memory, stripes of colour behind the menu).
+    inline bool conkerFocusApplies(const ConkerViewFocus &f, uint16_t colorImageWidth, uint32_t colorImageAddress) {
+        if (!f.on || (f.count <= 0) || (f.frameWidth <= 0.0f) || (colorImageWidth != uint16_t(f.frameWidth))) {
+            return false;
+        }
+        for (uint32_t image : f.ownImages) {
+            if ((image != 0) && ((image & 0x00FFFFFF) == (colorImageAddress & 0x00FFFFFF))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // A point of a focused view, where it goes in the frame: the view stretched to where it's drawn.
+    inline float conkerMapX(const ConkerFocusView &v, float x) { return v.left + (x - v.srcLeft) * (v.right - v.left) / (v.srcRight - v.srcLeft); }
+    inline float conkerMapY(const ConkerFocusView &v, float y) { return v.top + (y - v.srcTop) * (v.bottom - v.top) / (v.srcBottom - v.srcTop); }
+
+    // How much a focused view's projection is scaled across and down so what's drawn keeps its shape, from how much
+    // more it's stretched across than down (k). Alone across the frame it keeps its width of the scene and is made
+    // taller or shorter by k (a 2-player half, 1.26 / 2.04, about 0.62: more of the scene up and down; a quarter,
+    // about 1: unchanged). With two views, one made relatively wider (a quarter across half the frame, 2.04 / 1.0) is
+    // met halfway (`halfway`): by the square root of k across and down, more of the scene across and less up and
+    // down, rather than a band cut from the middle of it or a view twice as wide (which the widescreen widening
+    // would make wider again).
+    inline void conkerFocusScale(const ConkerFocusView &v, bool halfway, float &xScale, float &yScale) {
+        const float stretchX = (v.right - v.left) / (v.srcRight - v.srcLeft);
+        const float stretchY = (v.bottom - v.top) / (v.srcBottom - v.srcTop);
+        const float k = stretchX / stretchY;
+        if (!std::isfinite(k) || (k <= 0.0f) || (k <= 1.0f) || !halfway) {
+            xScale = 1.0f;
+            yScale = std::isfinite(k) && (k > 0.0f) ? k : 1.0f;
+            return;
+        }
+
+        const float root = std::sqrt(k);
+        xScale = 1.0f / root;
+        yScale = root;
+    }
+
+    // Where a rectangle (in pixels) stands: the whole frame (left alone), a focused view (`index`: moved with it),
+    // or another view (not drawn). Judged by its middle, so a view's own slightly different edges match.
+    enum class ConkerViewPart { Whole, Focused, Other };
+
+    inline ConkerViewPart conkerViewPart(const ConkerViewFocus &f, float left, float top, float right, float bottom, int &index, float slack = 0.0f) {
+        if (((right - left) >= 0.9f * f.frameWidth) && ((bottom - top) >= 0.9f * f.frameHeight)) {
+            return ConkerViewPart::Whole;
+        }
+        const float middleX = (left + right) / 2.0f;
+        const float middleY = (top + bottom) / 2.0f;
+        for (int i = 0; i < f.count; i++) {
+            const ConkerFocusView &v = f.views[i];
+            if ((middleX >= v.srcLeft - slack) && (middleX <= v.srcRight + slack) && (middleY >= v.srcTop - slack) && (middleY <= v.srcBottom + slack)) {
+                index = i;
+                return ConkerViewPart::Focused;
+            }
+        }
+        return ConkerViewPart::Other;
+    }
+
+    // Whether the focused view at x, y (pixels of the frame, where the game draws it) is drawn at one of `layouts`
+    // (gEXConkerFocusPlaced's bits): alone, across the whole frame (1); or the first of two, the top half (2); or
+    // the second, the bottom half (4).
+    inline bool conkerViewDrawnAt(const ConkerViewFocus &f, float x, float y, uint8_t layouts) {
+        int index = 0;
+        if (conkerViewPart(f, x, y, x, y, index) != ConkerViewPart::Focused) {
+            return false;
+        }
+        const uint8_t layout = (f.count == 1) ? 0x1 : (index == 0) ? 0x2 : 0x4;
+        return (layouts & layout) != 0;
+    }
+
+    // A rectangle of the frame's 2D (quarter pixels), moved with its focused view: false if it isn't drawn. Only moved,
+    // never scaled: the game draws a split screen's 2D at full size.
+    // - At the line between the top and bottom views (within 3 pixels of it): shared by the views. With one view
+    //   focused it's moved down to the bottom of the frame, all of it by as much so it keeps together: the match timer
+    //   in the middle of the frame, War's and Beach's team scores beside it, Heist's row of every player's $$$. With
+    //   two it stays on the line, which is where the two halves meet.
+    // - Its middle outside the focused views: another's, left out (a piece on the line between views belongs to the
+    //   one its middle is in, as Heist's $$$ rows).
+    // - Covering most of its view in fill mode (its clears, color and depth): all of where the view is drawn.
+    // - Otherwise its view's: moved as far as the view's nearest edges move, across and down. Its middle in the
+    //   first 30% of the view's width goes with the left edge, past 70% with the right, otherwise with the middle
+    //   (wide, so centered text such as "0 (1st)" moves whole); the same down. Kept inside where the view is drawn.
+    inline bool conkerMoveRect(const ConkerViewFocus &f, bool fillMode, FixedRect &rect) {
+        const float left = rect.ulx / 4.0f, top = rect.uly / 4.0f, right = rect.lrx / 4.0f, bottom = rect.lry / 4.0f;
+        if ((right - left >= 0.9f * f.frameWidth) && (bottom - top >= 0.9f * f.frameHeight)) {
+            return true;
+        }
+        const float splitLine = f.frameHeight / 2.0f;
+        const bool split = (f.views[0].srcBottom - f.views[0].srcTop) < 0.75f * f.frameHeight;
+        float moveX = 0.0f, moveY = 0.0f;
+        const float nearLine = 3.0f;
+        int index = 0;
+        if (split && (top < splitLine + nearLine) && (bottom > splitLine - nearLine)) {
+            if (f.count == 1) {
+                const float margin = 6.0f;
+                const float sharedHalfHeight = 6.0f;
+                moveY = (f.frameHeight - margin) - (splitLine + sharedHalfHeight);
+            }
+        }
+        else if (conkerViewPart(f, left, top, right, bottom, index, 1.0f) != ConkerViewPart::Focused) {
+            return false;
+        }
+        else {
+            const ConkerFocusView &v = f.views[index];
+            const float viewWidth = v.srcRight - v.srcLeft;
+            const float viewHeight = v.srcBottom - v.srcTop;
+            if (fillMode && (right - left >= 0.8f * viewWidth) && (bottom - top >= 0.8f * viewHeight)) {
+                rect.ulx = int32_t(v.left * 4.0f);
+                rect.uly = int32_t(v.top * 4.0f);
+                rect.lrx = int32_t(v.right * 4.0f);
+                rect.lry = int32_t(v.bottom * 4.0f);
+                return true;
+            }
+
+            auto edgeMove = [](float middle, float srcStart, float srcEnd, float start, float end) {
+                const float share = (middle - srcStart) / (srcEnd - srcStart);
+                if (share < 0.3f) return start - srcStart;
+                if (share > 0.7f) return end - srcEnd;
+                return (start + end) / 2.0f - (srcStart + srcEnd) / 2.0f;
+            };
+            moveX = edgeMove((left + right) / 2.0f, v.srcLeft, v.srcRight, v.left, v.right);
+            moveY = edgeMove((top + bottom) / 2.0f, v.srcTop, v.srcBottom, v.top, v.bottom);
+            // Kept inside where the view is drawn (a piece hanging over the view's edge would go past it), where it
+            // fits in it at all.
+            const float inset = 2.0f;
+            if ((right - left) <= (v.right - v.left) - 2.0f * inset) {
+                moveX = std::clamp(moveX, (v.left + inset) - left, (v.right - inset) - right);
+            }
+            if ((bottom - top) <= (v.bottom - v.top) - 2.0f * inset) {
+                moveY = std::clamp(moveY, (v.top + inset) - top, (v.bottom - inset) - bottom);
+            }
+        }
+        const int32_t dx = int32_t(std::lround(moveX * 4.0f));
+        const int32_t dy = int32_t(std::lround(moveY * 4.0f));
+        rect.ulx += dx;
+        rect.lrx += dx;
+        rect.uly += dy;
+        rect.lry += dy;
+        return true;
+    }
+};
diff --git a/src/common/rt64_fblog.h b/src/common/rt64_fblog.h
new file mode 100644
index 0000000..c9dd621
--- /dev/null
+++ b/src/common/rt64_fblog.h
@@ -0,0 +1,80 @@
+//
+// RT64
+//
+
+// TEMP-DEBUG (Conker): a log of what happens to framebuffers, depth and widening, for the
+// widescreen door clipping. Off unless CONKER_RT64_FBLOG is set. It then logs 2 frames out of
+// every 150 (about every 5 seconds), 40 times, to rt64_fb_log.txt in the working directory.
+// Frames are workload submission frames: the same number on the game's side (hle) and on the
+// renderer's side, which run on different threads.
+
+#pragma once
+
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+namespace RT64 {
+    namespace FbLog {
+        constexpr uint64_t Period = 150;
+        constexpr uint64_t FramesPerCapture = 2;
+        constexpr uint64_t Captures = 40;
+
+        inline bool enabled() {
+            static const bool on = (std::getenv("CONKER_RT64_FBLOG") != nullptr);
+            return on;
+        }
+
+        inline bool frameLogged(uint64_t frame) {
+            return enabled() && ((frame % Period) < FramesPerCapture) && ((frame / Period) < Captures);
+        }
+
+        // The frame being processed on this thread, for code that doesn't know its workload.
+        inline uint64_t &threadFrame() {
+            thread_local uint64_t frame = UINT64_MAX;
+            return frame;
+        }
+
+        // Which side this thread is: "hle" (the game's display lists, and the native render to
+        // RDRAM) or "hires" (the widened picture on screen).
+        inline const char *&threadSide() {
+            thread_local const char *side = "?";
+            return side;
+        }
+
+        inline void setThreadFrame(uint64_t frame, const char *side = nullptr) {
+            threadFrame() = frame;
+            if (side != nullptr) {
+                threadSide() = side;
+            }
+        }
+
+        inline bool threadActive() {
+            return (threadFrame() != UINT64_MAX) && frameLogged(threadFrame());
+        }
+
+        inline void print(const char *fmt, ...) {
+            static std::mutex mutex;
+            static FILE *file = nullptr;
+            std::lock_guard<std::mutex> lock(mutex);
+            if (file == nullptr) {
+                file = std::fopen("rt64_fb_log.txt", "w");
+                if (file == nullptr) {
+                    return;
+                }
+            }
+
+            va_list args;
+            va_start(args, fmt);
+            std::vfprintf(file, fmt, args);
+            va_end(args);
+            std::fputc('\n', file);
+            std::fflush(file);
+        }
+    };
+};
+
+#define RT64_FBLOG_RECT(r) (r).ulx, (r).uly, (r).lrx, (r).lry
+#define RT64_FBLOG_RECT_FMT "(%d,%d)-(%d,%d)"
