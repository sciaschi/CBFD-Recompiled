+        // The point lights' positions are in clip space (before the divide), as GLideN64 has them: a vertex
+        // is transformed by the modelview and projection first, then scaled by the coordinate modifier.
+        // The modelview-projection is only computed when the vertices are submitted (setVertexCommon),
+        // after the lighting, so it's computed here when it's out of date.
+        const hlslpp::float4x4 modelViewProj = modelViewProjChanged ?
+            hlslpp::mul(modelView, viewProjMatrixStack[projectionMatrixStackSize - 1]) : modelViewProjMatrix;
+
+        const uint8_t *rdram = state->fromRDRAM(0);
+        for (uint32_t i = dstIndex; i < dstIndex + vtxCount; i++) {
+            Vertex &vtx = vertices[i];
+            if (int16_t(vtx.flag) < 0) {
+                continue;
+            }
+
+            const hlslpp::float4 clip = hlslpp::mul(hlslpp::float4(float(vtx.x), float(vtx.y), float(vtx.z), 1.0f), modelViewProj);
+            const float px = (float(clip.x) + mod[8]) * mod[12];
+            const float py = (float(clip.y) + mod[9]) * mod[13];
+            const float pz = (float(clip.z) + mod[10]) * mod[14];
+
+            // The ambient colour follows the last light.
+            float r = cbfd.lights[numLights].r;
+            float g = cbfd.lights[numLights].g;
+            float b = cbfd.lights[numLights].b;
+
+            hlslpp::float3 normal(0.0f, 0.0f, 0.0f);
+            int l = numLights - 1;
+            if (cbfd.advancedLighting) {
+                const uint32_t normalAddress = cbfd.normalBase + (i << 1);
+                normal = hlslpp::float3(
+                    float(int8_t(rdram[(normalAddress + 0) ^ 3])) / 127.0f,
+                    float(int8_t(rdram[(normalAddress + 1) ^ 3])) / 127.0f,
+                    float(int8_t(vtx.flag & 0xFF)) / 127.0f);
+
+                // The last light is directional.
+                if (l >= 0) {
+                    float intensity = std::min(1.0f, float(hlslpp::dot(normal, lightDirs[l])));
+                    if (intensity > 0.0f) {
