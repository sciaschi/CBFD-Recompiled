+        // Conker: a split screen's row of views drawn in one pair (Beach's top two quarters in one, its bottom two in
+        // another): side by side they span the pair's width, and each is widened as if it had the pair to itself.
+        auto closeTo = [](int32_t a, int32_t b) { return std::abs(a - b) <= CoversWidthSlack; };
+        int32_t rowLeft = viewRect.ulx, rowRight = viewRect.lrx;
+        uint32_t rowViews = 0;
+        for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+            FixedRect otherRect;
+            if (!viewOfProjection(fbPair.projections[p], otherRect) || !closeTo(otherRect.uly, viewRect.uly) || !closeTo(otherRect.lry, viewRect.lry)) {
+                continue;
+            }
+
+            // Another view of the row, not one across it (its width is part of the row's).
+            if (!closeTo(otherRect.ulx, viewRect.ulx) || !closeTo(otherRect.lrx, viewRect.lrx)) {
+                rowViews++;
+            }
+
+            rowLeft = std::min(rowLeft, otherRect.ulx);
+            rowRight = std::max(rowRight, otherRect.lrx);
+        }
+
+        return (rowViews > 0) && (rowLeft <= pairScissor.ulx + CoversWidthViewportSlack) && (rowRight >= pairScissor.lrx - CoversWidthViewportSlack);
