+#define G_EX_CONKER_FOCUS_TOP       0x2
+#define G_EX_CONKER_FOCUS_BOTTOM    0x4
+#define gEXConkerFocusPlaced(cmd, mode, layouts, x, y) \
+    G_EX_COMMAND1(cmd, \
+        PARAM(RT64_EXTENDED_OPCODE, 8, 24) | PARAM(G_EX_CONKERFOCUSPLACED_V1, 24, 0), \
+        PARAM(mode, 2, 30) | PARAM(layouts, 3, 24) | PARAM(x, 10, 8) | PARAM(y, 8, 0) \
+    )
+
 #endif // RT64_EXTENDED_GBI
