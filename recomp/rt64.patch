+                u = (u + 1.0f) * 512.0f;
+                v = (v + 1.0f) * 512.0f;
+            }
+
+            vtx.s = int16_t(std::clamp(u * 32.0f, -32768.0f, 32767.0f));
+            vtx.t = int16_t(std::clamp(v * 32.0f, -32768.0f, 32767.0f));
+        }
+    }
