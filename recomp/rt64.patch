+            vtx.color.r = uint8_t(std::min(1.0f, r) * vtx.color.r);
+            vtx.color.g = uint8_t(std::min(1.0f, g) * vtx.color.g);
+            vtx.color.b = uint8_t(std::min(1.0f, b) * vtx.color.b);
+        }
+    }
