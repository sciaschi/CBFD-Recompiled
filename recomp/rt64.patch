+    bool Workload::pairWidensView(const FramebufferPair &fbPair, const Projection &proj) const {
+        FixedRect viewRect;
+        if (!viewOfProjection(proj, viewRect)) {
+            return false;
+        }
+
+        const FixedRect wideningScissor = fbPair.wideningScissor();
+        const FixedRect &pairScissor = wideningScissor.isNull() ? proj.scissorRect : wideningScissor;
+        if (viewRect.width(true, true) <= viewRect.height(true, true)) {
+            return false;
+        }
+
+        if ((viewRect.ulx <= pairScissor.ulx + CoversWidthViewportSlack) && (viewRect.lrx >= pairScissor.lrx - CoversWidthViewportSlack)) {
+            return true;
+        }
