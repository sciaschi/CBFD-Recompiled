# The server's name, which players connect to: its IPv4 address is looked up as the servers start. With
# Cloudflare, its record must be "DNS only" (grey cloud): the proxy carries no UDP.
PUBLIC_HOST=
# Or its public IPv4 address, which is used instead if set.
#PUBLIC_IP=
# Behind NAT (at home behind a router), the address the router forwards to, if not the one this machine's
# default route goes from (net finds that itself).
#HOME_LAN_IP=
# The secret the signalling server and coturn share, to make each player's TURN credentials: 16 characters
# or more, random (e.g. openssl rand -hex 24: letters and digits only). Players never see it.
TURN_SECRET=
# The status page (README.md: The status page), off unless set: a TCP port, and the address it listens on (all of
# this machine's by default: at home, a router that forwards only the UDP ports above keeps it to your network;
# on a VPS, a private address, or the firewall, must).
#STATUS_PORT=27180
#STATUS_ADDRESS=0.0.0.0
# Where the status's numbers are kept across restarts: a Docker volume (data) by default, or a folder on this
# machine, which user 65534 (nobody) must be able to write: sudo mkdir -p /srv/conker && sudo chown 65534:65534 /srv/conker
# (A path: with a / in it, ./conker for one beside compose.yaml.)
#DATA_DIR=/srv/conker
# Optional.
#IMAGE=ghcr.io/sciaschi/conker-netplay-server:latest
#SIGNAL_PORT=27100
#MAX_PER_ADDRESS=8
#TURN_HOURS=12
#TURN_TOTAL_QUOTA=400
#TURN_USER_QUOTA=32
#TURN_REALM=conker
# coturn's metrics, read by the signalling server (on 127.0.0.1).
#TURN_METRICS_PORT=9641
