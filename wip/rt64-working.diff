diff --git a/src/common/rt64_fblog.h b/src/common/rt64_fblog.h
new file mode 100644
index 0000000..c9dd621
--- /dev/null
+++ b/src/common/rt64_fblog.h
@@ -0,0 +1,80 @@
+//
+// RT64
+//
+
+// TEMP-DEBUG (Conker): a log of what happens to framebuffers, depth and widening, for the
+// widescreen door clipping. Off unless CONKER_RT64_FBLOG is set. It then logs 2 frames out of
+// every 150 (about every 5 seconds), 40 times, to rt64_fb_log.txt in the working directory.
+// Frames are workload submission frames: the same number on the game's side (hle) and on the
+// renderer's side, which run on different threads.
+
+#pragma once
+
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+namespace RT64 {
+    namespace FbLog {
+        constexpr uint64_t Period = 150;
+        constexpr uint64_t FramesPerCapture = 2;
+        constexpr uint64_t Captures = 40;
+
+        inline bool enabled() {
+            static const bool on = (std::getenv("CONKER_RT64_FBLOG") != nullptr);
+            return on;
+        }
+
+        inline bool frameLogged(uint64_t frame) {
+            return enabled() && ((frame % Period) < FramesPerCapture) && ((frame / Period) < Captures);
+        }
+
+        // The frame being processed on this thread, for code that doesn't know its workload.
+        inline uint64_t &threadFrame() {
+            thread_local uint64_t frame = UINT64_MAX;
+            return frame;
+        }
+
+        // Which side this thread is: "hle" (the game's display lists, and the native render to
+        // RDRAM) or "hires" (the widened picture on screen).
+        inline const char *&threadSide() {
+            thread_local const char *side = "?";
+            return side;
+        }
+
+        inline void setThreadFrame(uint64_t frame, const char *side = nullptr) {
+            threadFrame() = frame;
+            if (side != nullptr) {
+                threadSide() = side;
+            }
+        }
+
+        inline bool threadActive() {
+            return (threadFrame() != UINT64_MAX) && frameLogged(threadFrame());
+        }
+
+        inline void print(const char *fmt, ...) {
+            static std::mutex mutex;
+            static FILE *file = nullptr;
+            std::lock_guard<std::mutex> lock(mutex);
+            if (file == nullptr) {
+                file = std::fopen("rt64_fb_log.txt", "w");
+                if (file == nullptr) {
+                    return;
+                }
+            }
+
+            va_list args;
+            va_start(args, fmt);
+            std::vfprintf(file, fmt, args);
+            va_end(args);
+            std::fputc('\n', file);
+            std::fflush(file);
+        }
+    };
+};
+
+#define RT64_FBLOG_RECT(r) (r).ulx, (r).uly, (r).lrx, (r).lry
+#define RT64_FBLOG_RECT_FMT "(%d,%d)-(%d,%d)"
