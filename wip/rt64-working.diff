+    bool RigidBody::updateCameraCut(const hlslpp::float4x4 &prevView, const hlslpp::float4x4 &curView) {
+        // The camera itself (a view matrix's inverse): where it is (row 3) and which way it looks (row 2).
+        const hlslpp::float4x4 prevCamera = hlslpp::inverse(prevView);
+        const hlslpp::float4x4 curCamera = hlslpp::inverse(curView);
+        const float move = hlslpp::length(curCamera[3].xyz - prevCamera[3].xyz);
+        const hlslpp::float3 prevForward = prevCamera[2].xyz;
+        const hlslpp::float3 curForward = curCamera[2].xyz;
+        const float lengths = hlslpp::length(prevForward) * hlslpp::length(curForward);
+        const float cosTurn = (lengths > 1e-6f) ? float(hlslpp::dot(prevForward, curForward)) / lengths : 1.0f;
+        const float turn = std::acos(std::clamp(cosTurn, -1.0f, 1.0f));
